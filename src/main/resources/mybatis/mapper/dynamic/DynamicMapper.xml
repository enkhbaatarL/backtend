<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sk.domain.shared.mapper.dynamic.DynamicMapper">

    <!-- Mapper XML -->
    <resultMap id="targetPredictResultData" type="com.sk.domain.shared.mapper.dto.TargetPredictResultData">
        <result property="predictFulfillDate" column="prdc_fulf_dt"/>
        <result property="predictResultDate" column="prdc_rslt_dt"/>
        <result property="predictResultValue" column="prdc_rslt_val"/>
    </resultMap>

    <!-- 동적 SELECT 쿼리 -->
    <!-- SQL 인젝션 처리 필요 -->
    <select id="selectDynamic" parameterType="map" resultType="map">
        SELECT
        <if test="columns != null and columns != ''">
            ${columns}
        </if>
        <if test="columns == null or columns == ''">
            *
        </if>
        FROM ${tableName}
        <if test="whereClause != null and whereClause != ''">
            WHERE ${whereClause}
        </if>
        <if test="additionalWhereClause != null and additionalWhereClause != ''">
            AND ${additionalWhereClause}
        </if>
        <if test="orderByColumns != null and orderByColumns != ''">
            ORDER BY ${orderByColumns}
        </if>
        <if test="limit != null and limit != ''">
            LIMIT ${limit}
        </if>
        <if test="offset != null and offset != ''">
            OFFSET ${offset}
        </if>
    </select>

    <select id="selectPredictResultData" parameterType="map" resultMap="targetPredictResultData">
        SELECT
        <if test="columns != null and columns != ''">
            ${columns}
        </if>
        <if test="columns == null or columns == ''">
            *
        </if>
        FROM ${tableName}
        <if test="whereClause != null and whereClause != ''">
            WHERE ${whereClause}
        </if>
        <if test="additionalWhereClause != null and additionalWhereClause != ''">
            AND ${additionalWhereClause}
        </if>
        <if test="orderByColumns != null and orderByColumns != ''">
            ORDER BY ${orderByColumns}
        </if>
        <if test="limit != null and limit != ''">
            LIMIT ${limit}
        </if>
        <if test="offset != null and offset != ''">
            OFFSET ${offset}
        </if>
        <if test="groupByColumn != null and groupByColumn != ''">
            GROUP BY ${groupByColumn}
        </if>
    </select>

    <select id="selectDoubleValueResultData" parameterType="map" resultType="com.sk.domain.shared.mapper.dto.DoubleValueResultData">
        SELECT
        <if test="columns != null and columns != ''">
            ${columns}
        </if>
        <if test="columns == null or columns == ''">
            *
        </if>
        FROM ${tableName}
        <if test="whereClause != null and whereClause != ''">
            WHERE ${whereClause}
        </if>
        <if test="additionalWhereClause != null and additionalWhereClause != ''">
            AND ${additionalWhereClause}
        </if>
        <if test="orderByColumns != null and orderByColumns != ''">
            ORDER BY ${orderByColumns}
        </if>
        <if test="limit != null and limit != ''">
            LIMIT ${limit}
        </if>
        <if test="offset != null and offset != ''">
            OFFSET ${offset}
        </if>
        <if test="groupByColumn != null and groupByColumn != ''">
            GROUP BY ${groupByColumn}
        </if>
    </select>

    <insert id="saveDynamic" parameterType="map">
        INSERT INTO ${tableName} (
            <foreach collection="columns" item="col" separator=", ">
                #{col}
            </foreach>
        ) VALUES (
            <foreach collection="values" item="val" separator=", ">
                #{val}
            </foreach>
        )
    </insert>

    <!-- 정형데이터 일괄 저장 -->
    <insert id="saveAllDynamic" parameterType="map">
        INSERT INTO ${tableName}
            <trim prefix="(" suffix=")" suffixOverrides=",">
                <foreach collection="columns" item="col">
                    ${col},
                </foreach>
            </trim>
        VALUES
        <foreach collection="values" item="row" separator=",">
            <trim prefix="(" suffix=")" suffixOverrides=",">
                <foreach collection="row" item="value">
                    <if test="value == null">
                        NULL,
                    </if>
                    <if test="value != null">
                        #{value},
                    </if>
                </foreach>
            </trim>
        </foreach>
        ON DUPLICATE KEY UPDATE
        <trim suffixOverrides=",">
            <foreach collection="columns" item="col" index="index">
                <if test="col != 'id'"> <!-- 기본 키(id)를 제외하고 업데이트 -->
                    ${col} = VALUES(${col}),
                </if>
            </foreach>
            <!-- mod_dtm과 mod_usr_logn_id 명시적 업데이트 -->
            mod_dtm = CURRENT_TIMESTAMP,
            mod_usr_logn_id = #{currentUserId, jdbcType=VARCHAR}
        </trim>
    </insert>

    <!-- 예측 데이터 조회 -->
    <select id="selectDynamicForcastChart" parameterType="map" resultType="map">
        SELECT
        <if test="columns != null and columns != ''">
            ${columns}
        </if>
        <if test="columns == null or columns == ''">
            *
        </if>
        FROM ${tableName}
        <if test="innerJoin != null and innerJoin != ''">
            ${innerJoin}
        </if>
        <if test="orderByColumns != null and orderByColumns != ''">
            ORDER BY ${orderByColumns}
        </if>
    </select>
</mapper>
