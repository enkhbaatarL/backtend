# syntax=docker/dockerfile:1.7

FROM eclipse-temurin:17-jdk

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV JAVA_TOOL_OPTIONS="-Dfile.encoding=UTF-8"
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

ARG PLAYWRIGHT_VERSION=1.58.0

WORKDIR /opt/playwright

RUN set -eux; \
    if [ -f /etc/apt/sources.list ]; then \
      sed -i 's|http://archive.ubuntu.com/ubuntu|http://kr.archive.ubuntu.com/ubuntu|g' /etc/apt/sources.list; \
      sed -i 's|http://security.ubuntu.com/ubuntu|http://kr.archive.ubuntu.com/ubuntu|g' /etc/apt/sources.list; \
    fi; \
    if [ -d /etc/apt/sources.list.d ]; then \
      find /etc/apt/sources.list.d -type f \( -name "*.list" -o -name "*.sources" \) -exec \
        sed -i 's|http://archive.ubuntu.com/ubuntu|http://kr.archive.ubuntu.com/ubuntu|g; s|http://security.ubuntu.com/ubuntu|http://kr.archive.ubuntu.com/ubuntu|g' {} \; ; \
    fi; \
    ok=''; \
    for i in 1 2 3 4 5; do \
      apt-get update && ok=1 && break; \
      echo "apt-get update failed, retry $i"; \
      rm -rf /var/lib/apt/lists/*; \
      sleep 20; \
    done; \
    [ -n "$ok" ]; \
    asound_pkg="$(apt-cache show libasound2t64 >/dev/null 2>&1 && echo libasound2t64 || echo libasound2)"; \
    cups_pkg="$(apt-cache show libcups2t64 >/dev/null 2>&1 && echo libcups2t64 || echo libcups2)"; \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      maven \
      fonts-liberation \
      "${asound_pkg}" \
      libatk-bridge2.0-0 \
      libatk1.0-0 \
      libatspi2.0-0 \
      libcairo2 \
      "${cups_pkg}" \
      libdbus-1-3 \
      libdrm2 \
      libgbm1 \
      libglib2.0-0 \
      libgtk-3-0 \
      libnspr4 \
      libnss3 \
      libpango-1.0-0 \
      libx11-6 \
      libx11-xcb1 \
      libxcb1 \
      libxcomposite1 \
      libxdamage1 \
      libxext6 \
      libxfixes3 \
      libxkbcommon0 \
      libxrandr2 \
      xdg-utils; \
    rm -rf /var/lib/apt/lists/*

RUN set -eux \
    && mkdir -p /tmp/pw /ms-playwright \
    && cd /tmp/pw \
    && printf '%s\n' \
        '<project xmlns="http://maven.apache.org/POM/4.0.0"' \
        '         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"' \
        '         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">' \
        '  <modelVersion>4.0.0</modelVersion>' \
        '  <groupId>local</groupId>' \
        '  <artifactId>playwright-installer</artifactId>' \
        '  <version>1.0.0</version>' \
        '  <dependencies>' \
        '    <dependency>' \
        '      <groupId>com.microsoft.playwright</groupId>' \
        '      <artifactId>playwright</artifactId>' \
        "      <version>${PLAYWRIGHT_VERSION}</version>" \
        '    </dependency>' \
        '  </dependencies>' \
        '</project>' \
        > pom.xml \
    && mvn -q -DskipTests dependency:copy-dependencies -DincludeScope=runtime -DoutputDirectory=deps \
    && java -cp "deps/*" com.microsoft.playwright.CLI install chromium \
    && rm -rf /tmp/pw

WORKDIR /workspace
