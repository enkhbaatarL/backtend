# Copy to .env and fill in your DB connection values.
# Loaded by the local profile from the project working directory.
# Java properties format: do not wrap values in quotes or use export.
# Existing SKT_MI_DB_* environment variables take precedence.
METADATA_DB_TYPE=mysql
METADATA_DB_HOST=localhost
METADATA_DB_PORT=3306
METADATA_DB_NAME=midb
METADATA_DB_USERNAME=your_db_user
METADATA_DB_PASSWORD=your_db_password
