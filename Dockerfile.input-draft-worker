ARG WORKER_JRE_IMAGE
FROM ${WORKER_JRE_IMAGE}
USER root
RUN mkdir -p /app /work /scratch && chown 10001:10001 /app /work /scratch && chmod 700 /work /scratch
COPY --chown=10001:10001 classes /app/classes
COPY --chown=10001:10001 lib /app/lib
USER 10001:10001
WORKDIR /app
ENTRYPOINT ["java","-Xmx64m","-XX:ActiveProcessorCount=2","-XX:-UsePerfData","-XX:-HeapDumpOnOutOfMemoryError","-XX:ErrorFile=/dev/null","-cp","/app/classes:/app/lib/*","com.sk.domain.mi.service.fundamentalmodel.input.InputDraftWorkerSupervisor"]
